# Application
APP_NAME=Enterprise AI Support Agent
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Optional LLM settings are reserved for a later phase.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Phase 5 deterministic policy settings
KNOWLEDGE_PATH=data/knowledge.json
FRESHNESS_REFERENCE_DATE=2026-08-23
FRESHNESS_MAX_AGE_DAYS=365

# Phase 7 durable lifecycle and local role credentials.
# Replace every development key outside local demonstration.
LIFECYCLE_DB_PATH=data/support_agent.db
REVIEWER_API_KEY=dev-reviewer-key
REVIEWER_ACTOR=service-desk-lead
EXECUTOR_API_KEY=dev-executor-key
EXECUTOR_ACTOR=automation-operator
AUDITOR_API_KEY=dev-auditor-key
AUDITOR_ACTOR=audit-reader
