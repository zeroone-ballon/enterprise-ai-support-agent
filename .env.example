# Application
APP_NAME=Enterprise AI Support Agent
APP_ENV=development
APP_VERSION=1.0.0rc1
LOG_LEVEL=INFO

# Phase 9 defaults to deterministic generation and makes no LLM call.
GENERATION_MODE=deterministic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
# Phase 5 deterministic policy settings
KNOWLEDGE_PATH=data/knowledge.json
FRESHNESS_REFERENCE_DATE=2026-08-23
FRESHNESS_MAX_AGE_DAYS=365

# Phase 8 durable lifecycle and SHA-256 API-key digests.
# These are hashes of local demo keys; replace them outside local demonstration.
LIFECYCLE_DB_PATH=data/support_agent.db
REVIEWER_API_KEY_SHA256=2636892cb3695595303bfee4a077276f34a1f9be4a2879257bc4111b5ecc37c0
REVIEWER_ACTOR=service-desk-lead
EXECUTOR_API_KEY_SHA256=8a059a3e30ba84bd7b957c156d42b3e4cb5d61bf5712de83ebdd956c06e1204a
EXECUTOR_ACTOR=automation-operator
AUDITOR_API_KEY_SHA256=46151c35c1c09bca0b049ce55099e4f67fd04efe91716eec70fd1fa8ce898163
AUDITOR_ACTOR=audit-reader
